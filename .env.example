# CookBot Environment Variables

# Spoonacular API Key - Required
# Get one for free at: https://spoonacular.com/food-api
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# Google Gemini API Key - Optional (default key included in app.py)
# Get one for free at: https://ai.google.dev/
GENAI_KEY=your_gemini_api_key_here
